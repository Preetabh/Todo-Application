# Backend API Base URL
# IMPORTANT:
# - Physical Android Phone (Expo Go or APK): Use your computer's local Wi-Fi / LAN IP, e.g. http://192.168.1.100:5000/api
# - Android Emulator (AVD): Use the loopback alias http://10.0.2.2:5000/api
# - iOS Simulator: Use http://localhost:5000/api
# - Production (Render / Cloud): Use your deployed HTTPS URL, e.g. https://myfirstapp-api.onrender.com/api
#
# Frontend variables starting with EXPO_PUBLIC_ are bundled into the client build and are publicly visible.
# NEVER store secrets, private API keys, or database credentials here.
EXPO_PUBLIC_API_URL=https://todo-application-f0yf.onrender.com/api
